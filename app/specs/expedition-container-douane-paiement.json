{
  "module": "international-shipment-container-customs-payment",
  "goal": "End-to-end shipment lifecycle for individuals and businesses",
  "flow": [
    "shipment_created",
    "pickup_or_dropoff",
    "parcel_received",
    "consolidation",
    "container_assigned",
    "container_loaded",
    "container_departed",
    "in_transit",
    "destination_arrival",
    "customs_documents",
    "customs_processing",
    "fees_due",
    "payment_confirmed",
    "customs_cleared",
    "released",
    "last_mile",
    "delivered",
    "pod",
    "completed"
  ],
  "entities": [
    "Shipment",
    "ShipmentParty",
    "ShipmentItem",
    "Parcel",
    "ConsolidationLot",
    "Container",
    "ContainerLeg",
    "ContainerEvent",
    "TrackingEvent",
    "CustomsCase",
    "CustomsDeclaration",
    "CustomsDocument",
    "CustomsFee",
    "Document",
    "DocumentVersion",
    "Payment",
    "PaymentIntent",
    "PaymentAllocation",
    "Refund",
    "Payout",
    "Notification",
    "Incident",
    "ProofOfDelivery",
    "AuditLog"
  ],
  "adapters": [
    "TrackingProviderAdapter",
    "CustomsProviderAdapter",
    "CustomsRulesAdapter",
    "PaymentProviderAdapter",
    "NotificationProviderAdapter",
    "BillingProviderAdapter"
  ],
  "security": [
    "authentication",
    "RBAC/ABAC",
    "multi-tenant-isolation",
    "private-document-storage",
    "signed-download-urls",
    "server-side-payment-confirmation",
    "idempotency",
    "audit-log",
    "rate-limiting",
    "no-secrets-in-client"
  ],
  "acceptance": "User can create an international shipment, track parcels/container, manage customs documents, pay available charges in-app, and follow final delivery to POD."
}

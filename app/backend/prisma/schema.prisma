// Dev datasource is SQLite (zero-config, no local Postgres/Docker needed).
// To go to production: switch provider to "postgresql", point DATABASE_URL
// at the prod instance, then run `prisma migrate dev` again to generate a
// fresh Postgres migration (SQLite and Postgres migrations are not
// interchangeable). No model here uses a SQLite-only feature, so the schema
// itself needs no changes for the swap.
datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// Roles and statuses are plain strings (not Prisma enums) because the
// SQLite connector does not support native enums — this keeps the schema
// portable to Postgres without a migration rewrite. Valid values are
// enforced at the API boundary with zod (see src/utils/validation.ts).

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  phone        String?
  role         String // PARTICULIER | TRANSPORTEUR | ADMIN
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  missions      Mission[]      @relation("MissionOwner")
  offers        MissionOffer[] @relation("OfferProvider")
  organizations Organization[] @relation("OrganizationOwner")
  contractsAsOwner        Contract[] @relation("ContractOwner")
  contractsAsCounterparty Contract[] @relation("ContractCounterparty")
  documents               Document[] @relation("DocumentOwner")
  shipments               Shipment[] @relation("ShipmentOwner")
}

model Mission {
  id          String   @id @default(cuid())
  ownerId     String
  owner       User     @relation("MissionOwner", fields: [ownerId], references: [id])
  fromCity    String
  toCity      String
  date        DateTime
  cargo       String
  weightKg    Float
  vehicleType String
  budget      Float
  recurring   Boolean  @default(false)
  status      String   @default("PUBLISHED") // PUBLISHED | ATTRIBUTED | CONFIRMED | CANCELLED
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  offers    MissionOffer[]
  events    MissionEvent[]
  contracts Contract[]

  @@index([status])
  @@index([fromCity, toCity])
}

model MissionOffer {
  id         String   @id @default(cuid())
  missionId  String
  mission    Mission  @relation(fields: [missionId], references: [id])
  providerId String
  provider   User     @relation("OfferProvider", fields: [providerId], references: [id])
  price      Float
  message    String?
  status     String   @default("PENDING") // PENDING | ACCEPTED | REJECTED | WITHDRAWN
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([missionId, providerId])
}

// Lightweight per-mission audit trail so status changes stay historized,
// per the "les statuts doivent être historisés" rule in backend/README.md.
model MissionEvent {
  id        String   @id @default(cuid())
  missionId String
  mission   Mission  @relation(fields: [missionId], references: [id])
  type      String // STATUS_CHANGE | OFFER_RECEIVED | OFFER_ACCEPTED | OFFER_REJECTED
  data      String? // JSON-stringified payload
  createdAt DateTime @default(now())

  @@index([missionId])
}

// A company/professional entity a user creates via "Créer mon entreprise de
// transport". hasProfessionalCapacity intentionally does NOT unlock any
// regulated activity on its own — see MODULE_CAPACITE_PROFESSIONNELLE in the
// cahier des charges: JTransport must never present a qualification as a
// freely rentable/sellable product. VERIFIED only ever gets set by an
// administrator review, never by the organization itself.
model Organization {
  id                        String   @id @default(cuid())
  ownerId                   String
  owner                     User     @relation("OrganizationOwner", fields: [ownerId], references: [id])
  name                      String
  activity                  String // MARCHANDISES | VOYAGEURS | COMMISSIONNAIRE | LOGISTIQUE | MARITIME | AERIEN | FERROVIAIRE | AUTRE
  country                   String
  hasProfessionalCapacity   Boolean  @default(false)
  verificationStatus        String   @default("UNVERIFIED") // UNVERIFIED | PENDING | VERIFIED | REJECTED
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt

  capacities TransportCapacity[]
  contracts  Contract[]

  @@index([ownerId])
}

// A capacity an organization publishes to the marketplace ("Mes capacités &
// offres" / "proposer sa capacité").
model TransportCapacity {
  id               String    @id @default(cuid())
  organizationId   String
  organization     Organization @relation(fields: [organizationId], references: [id])
  vehicleType      String
  weightCapacityKg Float
  volumeCapacityM3 Float?
  zone             String
  availableFrom    DateTime
  availableTo      DateTime?
  pricePerUnit     Float?
  status           String    @default("PUBLISHED") // PUBLISHED | PAUSED | ARCHIVED
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([status])
  @@index([zone, vehicleType])
}

// Generated from an accepted mission offer. Signature here is an internal
// click-to-sign audit trail, NOT a qualified electronic signature — see
// src/utils/signature.ts and CONTRACTS.md caveat surfaced in the API/UI.
model Contract {
  id                   String    @id @default(cuid())
  missionId            String
  mission              Mission   @relation(fields: [missionId], references: [id])
  organizationId       String?
  organization         Organization? @relation(fields: [organizationId], references: [id])
  ownerId              String
  owner                User      @relation("ContractOwner", fields: [ownerId], references: [id])
  counterpartyId       String
  counterparty         User      @relation("ContractCounterparty", fields: [counterpartyId], references: [id])
  type                 String    @default("TRANSPORT") // TRANSPORT | SOUS_TRAITANCE | COMMISSIONNEMENT | MISE_A_DISPOSITION
  price                Float
  terms                String? // free-text conditions entered at creation
  status               String    @default("DRAFT") // DRAFT | SENT | PARTIALLY_SIGNED | FULLY_SIGNED | CANCELLED
  ownerSignedAt        DateTime?
  counterpartySignedAt DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  events    ContractEvent[]
  documents Document[]

  @@index([ownerId])
  @@index([counterpartyId])
}

model ContractEvent {
  id         String   @id @default(cuid())
  contractId String
  contract   Contract @relation(fields: [contractId], references: [id])
  type       String // CREATED | SIGNED_BY_OWNER | SIGNED_BY_COUNTERPARTY | FULLY_SIGNED
  data       String?
  createdAt  DateTime @default(now())

  @@index([contractId])
}

// Private per-dossier document vault (cahier des charges §15). A document
// always belongs to exactly one "dossier" (a Mission, a Contract, or an
// Organization) — dossierType/dossierId is a lightweight polymorphic
// reference kept as plain fields (not a Prisma relation union) so new
// dossier kinds (Shipment, CustomsCase, ...) can be added later without a
// schema migration touching this table. Access control is enforced in
// src/routes/documents.routes.ts, never by trusting the client.
model Document {
  id         String   @id @default(cuid())
  ownerId    String
  owner      User     @relation("DocumentOwner", fields: [ownerId], references: [id])
  contractId String? // optional direct relation, kept in sync with dossierId when dossierType = CONTRACT
  contract   Contract? @relation(fields: [contractId], references: [id])
  dossierType String // MISSION | CONTRACT | ORGANIZATION
  dossierId   String
  type        String // FACTURE | BON_LIVRAISON | POD | CONTRAT | ASSURANCE | DOUANE | AUTRE
  filename    String
  mimeType    String
  sizeBytes   Int
  storageKey  String // path on private disk storage, never served directly
  version     Int      @default(1)
  status      String   @default("ACTIVE") // ACTIVE | ARCHIVED
  createdAt   DateTime @default(now())

  events DocumentEvent[]

  @@index([dossierType, dossierId])
}

// Access audit trail — cahier des charges §15/§25: "Stockage privé,
// contrôle d'accès, URLs temporaires signées et audit".
model DocumentEvent {
  id         String   @id @default(cuid())
  documentId String
  document   Document @relation(fields: [documentId], references: [id])
  userId     String?
  type       String // UPLOADED | SIGNED_URL_ISSUED | DOWNLOADED | ARCHIVED
  createdAt  DateTime @default(now())

  @@index([documentId])
}

// International shipment: cahier des charges §9 end-to-end journey —
// création → collecte → groupage → conteneur → douane → livraison. Events
// are only ever written by an operator (ADMIN for now, until a real
// dispatcher/warehouse role is wired in) or a real integration adapter —
// never fabricated, per "ne jamais inventer une position/ETA/événement".
model Shipment {
  id                String   @id @default(cuid())
  ownerId           String
  owner             User     @relation("ShipmentOwner", fields: [ownerId], references: [id])
  originCity        String
  originCountry     String
  destinationCity   String
  destinationCountry String
  recipientName     String
  recipientPhone    String?
  recipientEmail    String?
  recipientAddress  String
  status            String   @default("CREATED")
  // CREATED | COLLECTED | AT_WAREHOUSE | GROUPED | IN_CONTAINER | LOADED |
  // DEPARTED | IN_TRANSIT | ARRIVED | CUSTOMS | CUSTOMS_CLEARED |
  // OUT_FOR_DELIVERY | DELIVERED | INCIDENT | CANCELLED
  containerId       String?
  container         Container? @relation(fields: [containerId], references: [id])
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  parcels     Parcel[]
  events      TrackingEvent[]
  customsCase CustomsCase?

  @@index([ownerId])
  @@index([status])
  @@index([containerId])
}

model Parcel {
  id             String  @id @default(cuid())
  shipmentId     String
  shipment       Shipment @relation(fields: [shipmentId], references: [id])
  description    String
  weightKg       Float
  lengthCm       Float?
  widthCm        Float?
  heightCm       Float?
  declaredValue  Float?

  @@index([shipmentId])
}

// FCL/LCL container carrying one or more shipments (cahier des charges §10).
model Container {
  id              String    @id @default(cuid())
  containerNumber String    @unique
  type            String // FCL_20 | FCL_40 | FCL_40HC | LCL
  sealNumber      String?
  originPort      String
  destinationPort String
  shippingLine    String?
  vesselName      String?
  etd             DateTime?
  eta             DateTime?
  status          String    @default("PREPARING") // PREPARING | LOADED | DEPARTED | IN_TRANSIT | ARRIVED | CUSTOMS | RELEASED | DELIVERED
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  shipments Shipment[]

  @@index([status])
}

// Real-only tracking timeline — never a guessed position or ETA.
model TrackingEvent {
  id         String   @id @default(cuid())
  shipmentId String
  shipment   Shipment @relation(fields: [shipmentId], references: [id])
  type       String // mirrors Shipment.status values, e.g. COLLECTED, DEPARTED, ARRIVED, DELIVERED, INCIDENT
  location   String?
  note       String?
  createdAt  DateTime @default(now())

  @@index([shipmentId])
}

// Digital customs dossier (cahier des charges §13). Amounts here are
// estimates until a real customs authority/broker integration is wired in
// — never presented as an official duty amount (see §31 quality rules).
model CustomsCase {
  id             String   @id @default(cuid())
  shipmentId     String   @unique
  shipment       Shipment @relation(fields: [shipmentId], references: [id])
  status         String   @default("DOCUMENTS_PENDING") // DOCUMENTS_PENDING | SUBMITTED | UNDER_REVIEW | CLEARED | BLOCKED
  declaredValue  Float?
  hsCode         String?
  incoterm       String?
  estimatedFees  Float?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([shipmentId])
}

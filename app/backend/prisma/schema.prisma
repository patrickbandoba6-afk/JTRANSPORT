// Dev datasource is SQLite (zero-config, no local Postgres/Docker needed).
// To go to production: switch provider to "postgresql", point DATABASE_URL
// at the prod instance, then run `prisma migrate dev` again to generate a
// fresh Postgres migration (SQLite and Postgres migrations are not
// interchangeable). No model here uses a SQLite-only feature, so the schema
// itself needs no changes for the swap.
datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// Roles and statuses are plain strings (not Prisma enums) because the
// SQLite connector does not support native enums — this keeps the schema
// portable to Postgres without a migration rewrite. Valid values are
// enforced at the API boundary with zod (see src/utils/validation.ts).

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  phone        String?
  role         String // PARTICULIER | TRANSPORTEUR | ADMIN
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  missions      Mission[]      @relation("MissionOwner")
  offers        MissionOffer[] @relation("OfferProvider")
  organizations Organization[] @relation("OrganizationOwner")
  contractsAsOwner        Contract[] @relation("ContractOwner")
  contractsAsCounterparty Contract[] @relation("ContractCounterparty")
  documents               Document[] @relation("DocumentOwner")
  shipments               Shipment[] @relation("ShipmentOwner")
  invoicesAsIssuer        Invoice[]  @relation("InvoiceIssuer")
  invoicesAsRecipient     Invoice[]  @relation("InvoiceRecipient")
  conversations           ConversationParticipant[] @relation("ConversationParticipantUser")
  messagesSent            Message[]  @relation("MessageSender")
  roundsAsDriver          DeliveryRound[] @relation("RoundDriver")
  roundsCreated           DeliveryRound[] @relation("RoundDispatcher")
  organizationMemberships OrganizationMember[] @relation("OrganizationMemberUser")
  incidentsOpened         Incident[] @relation("IncidentOpener")
  paymentsAsPayer         Payment[]  @relation("PaymentPayer")
  ratingsGiven            Rating[]   @relation("RatingAuthor")
  ratingsReceived         Rating[]   @relation("RatingSubject")
  disputesOpened          Dispute[]  @relation("DisputeOpener")
  disputeMessages         DisputeMessage[] @relation("DisputeMessageAuthor")
}

model Mission {
  id          String   @id @default(cuid())
  ownerId     String
  owner       User     @relation("MissionOwner", fields: [ownerId], references: [id])
  fromCity    String
  toCity      String
  date        DateTime
  cargo       String
  weightKg    Float
  vehicleType String
  budget      Float
  recurring   Boolean  @default(false)
  status      String   @default("PUBLISHED") // PUBLISHED | ATTRIBUTED | CONFIRMED | CANCELLED
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  offers        MissionOffer[]
  events        MissionEvent[]
  contracts     Contract[]
  conversations Conversation[]

  @@index([status])
  @@index([fromCity, toCity])
}

model MissionOffer {
  id         String   @id @default(cuid())
  missionId  String
  mission    Mission  @relation(fields: [missionId], references: [id])
  providerId String
  provider   User     @relation("OfferProvider", fields: [providerId], references: [id])
  price      Float
  message    String?
  status     String   @default("PENDING") // PENDING | ACCEPTED | REJECTED | WITHDRAWN
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([missionId, providerId])
}

// Lightweight per-mission audit trail so status changes stay historized,
// per the "les statuts doivent être historisés" rule in backend/README.md.
model MissionEvent {
  id        String   @id @default(cuid())
  missionId String
  mission   Mission  @relation(fields: [missionId], references: [id])
  type      String // STATUS_CHANGE | OFFER_RECEIVED | OFFER_ACCEPTED | OFFER_REJECTED
  data      String? // JSON-stringified payload
  createdAt DateTime @default(now())

  @@index([missionId])
}

// A company/professional entity a user creates via "Créer mon entreprise de
// transport". hasProfessionalCapacity intentionally does NOT unlock any
// regulated activity on its own — see MODULE_CAPACITE_PROFESSIONNELLE in the
// cahier des charges: JTransport must never present a qualification as a
// freely rentable/sellable product. VERIFIED only ever gets set by an
// administrator review, never by the organization itself.
model Organization {
  id                        String   @id @default(cuid())
  ownerId                   String
  owner                     User     @relation("OrganizationOwner", fields: [ownerId], references: [id])
  name                      String
  activity                  String // MARCHANDISES | VOYAGEURS | COMMISSIONNAIRE | LOGISTIQUE | MARITIME | AERIEN | FERROVIAIRE | AUTRE
  country                   String
  hasProfessionalCapacity   Boolean  @default(false)
  verificationStatus        String   @default("UNVERIFIED") // UNVERIFIED | PENDING | VERIFIED | REJECTED
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt

  capacities TransportCapacity[]
  contracts  Contract[]
  members    OrganizationMember[]
  parcels    Parcel[]             @relation("ParcelOwnerOrganization")
  roundsAsCarrier DeliveryRound[] @relation("RoundCarrierOrganization")

  @@index([ownerId])
}

// A capacity an organization publishes to the marketplace ("Mes capacités &
// offres" / "proposer sa capacité").
model TransportCapacity {
  id               String    @id @default(cuid())
  organizationId   String
  organization     Organization @relation(fields: [organizationId], references: [id])
  vehicleType      String
  weightCapacityKg Float
  volumeCapacityM3 Float?
  zone             String
  availableFrom    DateTime
  availableTo      DateTime?
  pricePerUnit     Float?
  status           String    @default("PUBLISHED") // PUBLISHED | PAUSED | ARCHIVED
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  contracts Contract[]

  @@index([status])
  @@index([zone, vehicleType])
}

// Generated either from an accepted mission offer OR directly from a
// published TransportCapacity ("louer sa capacité" — cahier des charges
// §16/§25). Exactly one of missionId/capacityId is set; enforced in
// src/routes/contracts.routes.ts, not at the schema level. Signature here
// is an internal click-to-sign audit trail, NOT a qualified electronic
// signature — see src/utils/signature.ts.
model Contract {
  id                   String    @id @default(cuid())
  missionId            String?
  mission              Mission?  @relation(fields: [missionId], references: [id])
  capacityId           String?
  capacity             TransportCapacity? @relation(fields: [capacityId], references: [id])
  organizationId       String?
  organization         Organization? @relation(fields: [organizationId], references: [id])
  ownerId              String
  owner                User      @relation("ContractOwner", fields: [ownerId], references: [id])
  counterpartyId       String
  counterparty         User      @relation("ContractCounterparty", fields: [counterpartyId], references: [id])
  type                 String    @default("TRANSPORT") // TRANSPORT | SOUS_TRAITANCE | COMMISSIONNEMENT | MISE_A_DISPOSITION
  price                Float
  terms                String? // free-text conditions entered at creation
  status               String    @default("DRAFT") // DRAFT | SENT | PARTIALLY_SIGNED | FULLY_SIGNED | CANCELLED
  ownerSignedAt        DateTime?
  counterpartySignedAt DateTime?
  // Hand-drawn signature strokes (JSON point list), captured on the
  // signature pad. Part of the internal audit trail — still not a
  // qualified electronic signature (see src/utils/signature.ts).
  ownerSignaturePath        String?
  counterpartySignaturePath String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  events    ContractEvent[]
  documents Document[]
  invoices  Invoice[]
  ratings   Rating[]
  disputes  Dispute[]

  @@index([ownerId])
  @@index([counterpartyId])
  @@index([capacityId])
}

model ContractEvent {
  id         String   @id @default(cuid())
  contractId String
  contract   Contract @relation(fields: [contractId], references: [id])
  type       String // CREATED | SIGNED_BY_OWNER | SIGNED_BY_COUNTERPARTY | FULLY_SIGNED
  data       String?
  createdAt  DateTime @default(now())

  @@index([contractId])
}

// Private per-dossier document vault (cahier des charges §15). A document
// always belongs to exactly one "dossier" (a Mission, a Contract, or an
// Organization) — dossierType/dossierId is a lightweight polymorphic
// reference kept as plain fields (not a Prisma relation union) so new
// dossier kinds (Shipment, CustomsCase, ...) can be added later without a
// schema migration touching this table. Access control is enforced in
// src/routes/documents.routes.ts, never by trusting the client.
model Document {
  id         String   @id @default(cuid())
  ownerId    String
  owner      User     @relation("DocumentOwner", fields: [ownerId], references: [id])
  contractId String? // optional direct relation, kept in sync with dossierId when dossierType = CONTRACT
  contract   Contract? @relation(fields: [contractId], references: [id])
  dossierType String // MISSION | CONTRACT | ORGANIZATION
  dossierId   String
  type        String // FACTURE | BON_LIVRAISON | POD | CONTRAT | ASSURANCE | DOUANE | AUTRE
  filename    String
  mimeType    String
  sizeBytes   Int
  storageKey  String // path on private disk storage, never served directly
  version     Int      @default(1)
  status      String   @default("ACTIVE") // ACTIVE | ARCHIVED
  createdAt   DateTime @default(now())

  events DocumentEvent[]

  @@index([dossierType, dossierId])
}

// Access audit trail — cahier des charges §15/§25: "Stockage privé,
// contrôle d'accès, URLs temporaires signées et audit".
model DocumentEvent {
  id         String   @id @default(cuid())
  documentId String
  document   Document @relation(fields: [documentId], references: [id])
  userId     String?
  type       String // UPLOADED | SIGNED_URL_ISSUED | DOWNLOADED | ARCHIVED
  createdAt  DateTime @default(now())

  @@index([documentId])
}

// International shipment: cahier des charges §9 end-to-end journey —
// création → collecte → groupage → conteneur → douane → livraison. Events
// are only ever written by an operator (ADMIN for now, until a real
// dispatcher/warehouse role is wired in) or a real integration adapter —
// never fabricated, per "ne jamais inventer une position/ETA/événement".
model Shipment {
  id                String   @id @default(cuid())
  ownerId           String
  owner             User     @relation("ShipmentOwner", fields: [ownerId], references: [id])
  originCity        String
  originCountry     String
  destinationCity   String
  destinationCountry String
  recipientName     String
  recipientPhone    String?
  recipientEmail    String?
  recipientAddress  String
  // How it travels and what it carries — drives the customs paperwork
  // checklist (see CustomsRequirement).
  mode              String   @default("ROUTIER") // ROUTIER | MARITIME | AERIEN | FERROVIAIRE | MULTIMODAL
  cargoType         String   @default("COLIS") // COLIS | MARCHANDISE | VEHICULE | CONTENEUR
  status            String   @default("CREATED")
  // CREATED | COLLECTED | AT_WAREHOUSE | GROUPED | IN_CONTAINER | LOADED |
  // DEPARTED | IN_TRANSIT | ARRIVED | CUSTOMS | CUSTOMS_CLEARED |
  // OUT_FOR_DELIVERY | DELIVERED | INCIDENT | CANCELLED
  containerId       String?
  container         Container? @relation(fields: [containerId], references: [id])
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  parcels     Parcel[]
  events      TrackingEvent[]
  customsCase CustomsCase?
  vehicles    ShipmentVehicle[]

  @@index([ownerId])
  @@index([status])
  @@index([containerId])
}

// A parcel is the central traceable object. It can come from a customer
// shipment (shipmentId) or from a company batch (organizationId). Its
// history lives in ParcelEvent, which is append-only: a mistake is fixed
// by adding a CORRECTION event, never by rewriting the past — that's what
// makes the chain of responsibility hold up afterwards.
model Parcel {
  id             String  @id @default(cuid())
  code           String  @unique
  shipmentId     String?
  shipment       Shipment? @relation(fields: [shipmentId], references: [id])
  organizationId String?
  organization   Organization? @relation("ParcelOwnerOrganization", fields: [organizationId], references: [id])
  description    String
  weightKg       Float
  lengthCm       Float?
  widthCm        Float?
  heightCm       Float?
  declaredValue  Float?
  recipientName    String?
  recipientAddress String?

  status         String  @default("CREATED") // see PARCEL_STATUSES
  // Who physically holds the parcel right now.
  custodianType  String  @default("ORGANIZATION") // ORGANIZATION | CARRIER | DRIVER | RECIPIENT
  custodianOrgId String?
  custodianUserId String?

  roundId String?
  round   DeliveryRound? @relation(fields: [roundId], references: [id])

  events    ParcelEvent[]
  incidents Incident[]

  @@index([shipmentId])
  @@index([organizationId])
  @@index([roundId])
  @@index([status])
}

// Append-only. Every entry answers: who, what, when, where, with what proof.
model ParcelEvent {
  id        String   @id @default(cuid())
  parcelId  String
  parcel    Parcel   @relation(fields: [parcelId], references: [id])
  type      String // see PARCEL_EVENT_TYPES
  actorId   String? // the user who performed the action
  actorLabel String? // human-readable snapshot (name + org) at that time
  location  String?
  proof     String? // JSON: scan code, signature strokes, photo reference…
  note      String?
  createdAt DateTime @default(now())

  @@index([parcelId])
}

// Graduated incident handling — nothing is ever auto-labelled a theft.
model Incident {
  id         String   @id @default(cuid())
  parcelId   String
  parcel     Parcel   @relation(fields: [parcelId], references: [id])
  status     String   @default("SIGNALE") // see INCIDENT_STATUSES
  reason     String
  openedById String?
  openedBy   User?    @relation("IncidentOpener", fields: [openedById], references: [id])
  resolution String?
  resolvedAt DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([parcelId])
  @@index([status])
}

// Dispatch, logistics management and driving are roles held inside an
// organization, not standalone account types: each person keeps their own
// login, so every action stays attributable to a named human.
model OrganizationMember {
  id             String   @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  userId         String
  user           User     @relation("OrganizationMemberUser", fields: [userId], references: [id])
  role           String // ADMINISTRATEUR | RESPONSABLE_LOGISTIQUE | DISPATCHER | OPERATEUR | CHAUFFEUR
  createdAt      DateTime @default(now())

  @@unique([organizationId, userId])
  @@index([userId])
}

// FCL/LCL container carrying one or more shipments (cahier des charges §10).
model Container {
  id              String    @id @default(cuid())
  containerNumber String    @unique
  type            String // FCL_20 | FCL_40 | FCL_40HC | LCL
  sealNumber      String?
  originPort      String
  destinationPort String
  shippingLine    String?
  vesselName      String?
  etd             DateTime?
  eta             DateTime?
  status          String    @default("PREPARING") // PREPARING | LOADED | DEPARTED | IN_TRANSIT | ARRIVED | CUSTOMS | RELEASED | DELIVERED
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  shipments Shipment[]

  @@index([status])
}

// Real-only tracking timeline — never a guessed position or ETA.
model TrackingEvent {
  id         String   @id @default(cuid())
  shipmentId String
  shipment   Shipment @relation(fields: [shipmentId], references: [id])
  type       String // mirrors Shipment.status values, e.g. COLLECTED, DEPARTED, ARRIVED, DELIVERED, INCIDENT
  location   String?
  note       String?
  createdAt  DateTime @default(now())

  @@index([shipmentId])
}

// Digital customs dossier (cahier des charges §13). Amounts here are
// estimates until a real customs authority/broker integration is wired in
// — never presented as an official duty amount (see §31 quality rules).
model CustomsCase {
  id             String   @id @default(cuid())
  shipmentId     String   @unique
  shipment       Shipment @relation(fields: [shipmentId], references: [id])
  status         String   @default("DOCUMENTS_PENDING") // DOCUMENTS_PENDING | SUBMITTED | UNDER_REVIEW | CLEARED | BLOCKED
  declaredValue  Float?
  hsCode         String?
  incoterm       String?
  // An estimate and an officially notified amount are two different things
  // and are never merged (cahier des charges §13/§31). officialFees is only
  // ever filled from an amount actually notified by the authority or the
  // customs broker handling the file.
  estimatedFees  Float?
  officialFees   Float?
  feesStatus     String   @default("NONE") // NONE | ESTIMATED | OFFICIAL | PAID
  feesPaidAt     DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([shipmentId])
}

// Vehicle being shipped (car, motorcycle, van, truck…). Kept separate from
// parcels because customs and carriers ask for different paperwork.
model ShipmentVehicle {
  id         String   @id @default(cuid())
  shipmentId String
  shipment   Shipment @relation(fields: [shipmentId], references: [id])
  make       String
  model      String
  year       Int?
  vin        String?
  plate      String?
  condition  String? // ROULANT | NON_ROULANT | ACCIDENTE
  valueDeclared Float?

  @@index([shipmentId])
}

// Paperwork checklist per transport mode / cargo type / country pair.
// Deliberately a table and not a hardcoded list: customs rules change and
// differ by country, so they must stay configurable (cahier des charges
// §26/§36) and are shown as indicative, never as legal advice.
model CustomsRequirement {
  id           String  @id @default(cuid())
  mode         String? // null = applies to every mode
  cargoType    String? // null = applies to every cargo type
  countryFrom  String?
  countryTo    String?
  documentType String // matches DOCUMENT_TYPES where possible
  label        String
  mandatory    Boolean @default(true)
  note         String?

  @@index([mode, cargoType])
}

// Invoice generated from a FULLY_SIGNED contract (cahier des charges §16/20).
// eInvoicingStatus/eInvoicingProvider record whether a real electronic-
// invoicing platform actually transmitted it — see src/utils/einvoicing.ts.
// Never claim Chorus Pro/Peppol/PDP transmission happened unless a real
// adapter call succeeded; the internal default adapter never sets more than
// "NOT_TRANSMITTED".
model Invoice {
  id                String   @id @default(cuid())
  number            String   @unique // e.g. JT-2026-000123
  contractId        String
  contract          Contract @relation(fields: [contractId], references: [id])
  issuerId          String
  issuer            User     @relation("InvoiceIssuer", fields: [issuerId], references: [id])
  recipientId       String
  recipient         User     @relation("InvoiceRecipient", fields: [recipientId], references: [id])
  status            String   @default("DRAFT") // DRAFT | SENT | PAID | OVERDUE | CANCELLED
  currency          String   @default("EUR")
  subtotal          Float
  taxRate           Float    @default(0)
  taxAmount         Float    @default(0)
  total             Float
  dueDate           DateTime?
  paidAt            DateTime?
  eInvoicingStatus  String   @default("NOT_TRANSMITTED") // NOT_TRANSMITTED | TRANSMITTED | FAILED
  eInvoicingProvider String? // set only once a real adapter is configured and used
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  lines    InvoiceLine[]
  payments Payment[]

  @@index([issuerId])
  @@index([recipientId])
  @@index([contractId])
}

model InvoiceLine {
  id          String  @id @default(cuid())
  invoiceId   String
  invoice     Invoice @relation(fields: [invoiceId], references: [id])
  description String
  quantity    Float   @default(1)
  unitPrice   Float
  amount      Float

  @@index([invoiceId])
}

// In-app messaging (cahier des charges §8/§12). This is the channel that
// lets a particulier and a professional talk without exposing personal
// phone numbers or addresses: contact details stay private, the
// conversation carries the exchange. A conversation can be attached to a
// mission for context.
model Conversation {
  id        String   @id @default(cuid())
  subject   String?
  missionId String?
  mission   Mission? @relation(fields: [missionId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  participants ConversationParticipant[]
  messages     Message[]

  @@index([missionId])
}

model ConversationParticipant {
  id             String   @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  userId         String
  user           User     @relation("ConversationParticipantUser", fields: [userId], references: [id])
  lastReadAt     DateTime?

  @@unique([conversationId, userId])
  @@index([userId])
}

model Message {
  id             String   @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  senderId       String
  sender         User     @relation("MessageSender", fields: [senderId], references: [id])
  body           String
  createdAt      DateTime @default(now())

  @@index([conversationId])
}

// Dispatcher / last-mile (cahier des charges §17). A dispatcher builds a
// round, assigns it to one of their drivers, and the driver works through
// the ordered stops from the JTransport Driver screens. Every scan and
// status change is written as a RoundStopEvent so the timeline is real,
// never reconstructed after the fact.
model DeliveryRound {
  id           String   @id @default(cuid())
  reference    String   @unique // e.g. TRN-2026-0001
  // The company the round belongs to, and the dispatcher (a member of that
  // company) who built it.
  organizationId String?
  dispatcherId String
  dispatcher   User     @relation("RoundDispatcher", fields: [dispatcherId], references: [id])
  // The carrier company the parcels are handed over to, and optionally the
  // individual driver doing the run.
  carrierOrgId String?
  carrierOrg   Organization? @relation("RoundCarrierOrganization", fields: [carrierOrgId], references: [id])
  driverId     String?
  driver       User?    @relation("RoundDriver", fields: [driverId], references: [id])
  date         DateTime
  status       String   @default("PLANNED") // PLANNED | ASSIGNED | IN_PROGRESS | COMPLETED | CANCELLED
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  stops   RoundStop[]
  parcels Parcel[]

  @@index([dispatcherId])
  @@index([driverId])
  @@index([status])
}

model RoundStop {
  id          String   @id @default(cuid())
  roundId     String
  round       DeliveryRound @relation(fields: [roundId], references: [id])
  position    Int
  label       String // e.g. "Paris 75001"
  address     String
  parcelCode  String? // barcode/QR scanned by the driver
  recipient   String?
  status      String   @default("PENDING") // PENDING | IN_PROGRESS | DELIVERED | FAILED
  podSignature String? // hand-drawn proof-of-delivery strokes (JSON)
  podNote     String?
  failureReason String?
  completedAt DateTime?

  events RoundStopEvent[]

  @@index([roundId])
}

model RoundStopEvent {
  id        String   @id @default(cuid())
  stopId    String
  stop      RoundStop @relation(fields: [stopId], references: [id])
  type      String // SCANNED | IN_PROGRESS | DELIVERED | FAILED
  data      String?
  createdAt DateTime @default(now())

  @@index([stopId])
}

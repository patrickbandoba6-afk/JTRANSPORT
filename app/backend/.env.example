# Dev default: local SQLite file, zero config.
# Prod: swap prisma/schema.prisma provider to "postgresql" and point this at
# your Postgres instance (Render/Neon/Supabase/RDS...).
DATABASE_URL="file:./dev.db"

# Long random string. Generate with: openssl rand -base64 48
JWT_SECRET="change-me-in-every-environment"

# Comma-separated list of allowed browser origins for CORS.
CORS_ORIGIN="http://localhost:3000"

PORT=4000
NODE_ENV=development
